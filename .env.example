# Supabase Connection String (Transaction mode / Pooled - Port 6543)
DATABASE_URL="postgresql://user:password@host:port/postgres?pgbouncer=true"

# Direct Connection String (Session mode - Port 5432) - Required for Prisma DB Push
DIRECT_URL="postgresql://user:password@host:port/postgres"

# Auth & Security
JWT_SECRET="your-secret-key-here"
ADMIN_CODE="your-librarian-access-code"

# App URL
APP_URL="http://localhost:3000"

